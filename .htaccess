# Finora — só o que está em site/ (e as páginas da raiz) deve ser público.
# O resto é código interno, configuração ou dados: o Apache responde 404.

# Sem listagem de pastas
Options -Indexes

# Ficheiros e pastas escondidos (.git, .env, .gitignore, .htaccess, .DS_Store)
RedirectMatch 404 /\.

# Pastas internas: configuração, scripts de linha de comandos, BD, dependências e documentação
RedirectMatch 404 ^/(.*/)?(config|cron|database|vendor|docs|aprendizagem|design)(/|$)

# Ficheiros do Composer e imagens/ficheiros de desenvolvimento da raiz
<FilesMatch "^(composer\.(json|lock)|ModeloER\.png|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>

# Cookie de sessão mais seguro
#   httponly    → o JavaScript não consegue ler o cookie (um XSS não rouba a sessão)
#   samesite    → o browser não envia o cookie em pedidos vindos de outros sites (camada extra contra CSRF)
#   strict_mode → o PHP recusa IDs de sessão que não foi ele a criar (session fixation)
# Em produção com HTTPS, acrescentar também: php_flag session.cookie_secure On
<IfModule php_module>
    php_flag  session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag  session.use_strict_mode On
</IfModule>

# Cabeçalhos de segurança em todas as respostas (a Content-Security-Policy vem do PHP,
# site/helpers/security_headers.php, porque leva um nonce novo em cada pedido).
# O HSTS (Strict-Transport-Security) já é posto pela configuração do Apache no servidor.
#   nosniff            → o browser não "adivinha" o tipo de um ficheiro (um .txt não corre como script)
#   Referrer-Policy    → outros sites só veem o domínio de onde vens, nunca o caminho nem o ?query
#   X-Frame-Options    → ninguém mete a Finora num iframe (clickjacking); o frame-ancestors da CSP faz o mesmo nos browsers novos
#   Permissions-Policy → câmara só para a própria Finora (Ler fatura); o resto desligado
#   COOP               → uma janela de outro site aberta a partir daqui não consegue mexer nesta
# setifempty: uma página pode pôr uma regra mais apertada (as de login usam Referrer-Policy: same-origin)
<IfModule mod_headers.c>
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header setifempty X-Frame-Options "DENY"
    Header setifempty Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
    Header setifempty Cross-Origin-Opener-Policy "same-origin"
</IfModule>
